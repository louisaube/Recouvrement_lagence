{
  "name": "@recouvrement/api",
  "version": "1.0.0",
  "private": true,
  "description": "API du socle (NestJS, Zod, Drizzle, PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "type:check": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test jest --runInBand",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:gen": "drizzle-kit generate",
    "migrate:all": "tsx scripts/migrate.ts --all",
    "cuisine:openapi": "tsc -p tsconfig.build.json && node dist/platform/cli/openapi.cli.js",
    "cuisine:routes": "tsc -p tsconfig.build.json && node dist/platform/cli/routes.cli.js"
  },
  "dependencies": {
    "@gorules/zen-engine": "^2.1.6",
    "@maleus/xlsx": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "streamsearch": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@recouvrement/api-client": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
